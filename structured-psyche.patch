@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+    buildStructuredPsycheResponseFormat,
+    parseStructuredPsyche,
+    shouldUseStructuredPsyche,
+} from './structuredPsyche';
+
+describe('shouldUseStructuredPsyche', () => {
+    it('gates only on the Structured Psyche enablement state', () => {
+        expect(shouldUseStructuredPsyche({ enabled: true })).toBe(true);
+        expect(shouldUseStructuredPsyche({ enabled: false })).toBe(false);
+    });
+});
+
+describe('buildStructuredPsycheResponseFormat', () => {
+    it('defines the strict reply and psyche schema', () => {
+        const format = buildStructuredPsycheResponseFormat();
+        expect(format.type).toBe('json_schema');
+        expect(format.json_schema.schema.required).toEqual(['reply', 'psyche']);
+        expect(format.json_schema.schema.additionalProperties).toBe(false);
+        expect(Object.keys(format.json_schema.schema.properties)).toEqual(['reply', 'psyche']);
+    });
+});
+
+describe('parseStructuredPsyche', () => {
+    it('parses and trims a valid envelope', () => {
+        expect(parseStructuredPsyche('{"reply":" hello ","psyche":" hmm "}')).toEqual({
+            reply: 'hello',
+            psyche: 'hmm',
+        });
+    });
+
+    it.each([
+        ['invalid JSON', '{'],
+        ['null', null],
+        ['array', '[]'],
+        ['missing reply', '{"psyche":"hmm"}'],
+        ['missing psyche', '{"reply":"hello"}'],
+        ['blank reply', '{"reply":"  ","psyche":"hmm"}'],
+        ['blank psyche', '{"reply":"hello","psyche":"  "}'],
+    ])('rejects %s', (_label, value) => {
+        expect(() => parseStructuredPsyche(value)).toThrow(/structured psyche protocol error/i);
+    });
+});
diff --git a/utils/structuredPsyche.ts b/utils/structuredPsyche.ts
new file mode 100644
--- /dev/null
+++ b/utils/structuredPsyche.ts
@@ -0,0 +1,60 @@
+export interface StructuredPsyche {
+    reply: string;
+    psyche: string;
+}
+
+export const shouldUseStructuredPsyche = (input: {
+    enabled: boolean;
+}): boolean => input.enabled;
+
+export const buildStructuredPsycheResponseFormat = () => ({
+    type: 'json_schema' as const,
+    json_schema: {
+        name: 'roleplay_response',
+        schema: {
+            type: 'object' as const,
+            properties: {
+                reply: {
+                    type: 'string' as const,
+                    description: 'The character reply that is spoken aloud to the user.',
+                },
+                psyche: {
+                    type: 'string' as const,
+                    description: 'The character first-person immediate inner activity that remains unspoken.',
+                },
+            },
+            required: ['reply', 'psyche'],
+            additionalProperties: false,
+        },
+    },
+});
+
+export function parseStructuredPsyche(content: unknown): StructuredPsyche {
+    if (typeof content !== 'string') {
+        throw new Error('Structured psyche protocol error: message.content must be a string');
+    }
+
+    let parsed: unknown;
+    try {
+        parsed = JSON.parse(content);
+    } catch {
+        throw new Error('Structured psyche protocol error: message.content is not valid JSON');
+    }
+
+    if (parsed === null || Array.isArray(parsed) || typeof parsed !== 'object') {
+        throw new Error('Structured psyche protocol error: top-level JSON must be an object');
+    }
+
+    const record = parsed as Record<string, unknown>;
+    if (typeof record.reply !== 'string' || !record.reply.trim()) {
+        throw new Error('Structured psyche protocol error: reply must be a non-empty string');
+    }
+    if (typeof record.psyche !== 'string' || !record.psyche.trim()) {
+        throw new Error('Structured psyche protocol error: psyche must be a non-empty string');
+    }
+
+    return {
+        reply: record.reply.trim(),
+        psyche: record.psyche.trim(),
+    };
+}
