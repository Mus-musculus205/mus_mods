+import { describe, expect, it } from 'vitest';
+
+import type { Message } from '../types';
+import { ChatPrompts } from './chatPrompts';
+
+describe('Structured psyche context isolation', () => {
+    it('keeps persisted psyche metadata out of subsequent model history', () => {
+        const privatePsyche = 'PRIVATE_PSYCHE_MUST_NOT_ENTER_CONTEXT';
+        const messages = [{
+            id: 1,
+            charId: 'char-1',
+            role: 'assistant',
+            type: 'text',
+            content: '这是角色真正说出口的话。',
+            timestamp: Date.now(),
+            metadata: { thinkingChain: privatePsyche },
+        }] as Message[];
+
+        const { apiMessages } = ChatPrompts.buildMessageHistory(
+            messages,
+            10,
+            { id: 'char-1', name: '角色' } as any,
+            { name: '用户' } as any,
+            [],
+        );
+        const serialized = JSON.stringify(apiMessages);
+
+        expect(serialized).toContain('这是角色真正说出口的话。');
+        expect(serialized).not.toContain(privatePsyche);
+        expect(serialized).not.toContain('thinkingChain');
+    });
+});
